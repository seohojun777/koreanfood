---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="inner">
		<p class="name">{SITE_TITLE}</p>
		<nav aria-label="하단 메뉴">
			<a href="/blog">글 목록</a>
			<a href="/about">소개</a>
			<a href="/rss.xml">RSS</a>
		</nav>
		<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 5rem;
		border-top: 1px solid var(--ink);
		background: var(--bg);
	}
	.inner {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 2.5rem 1.25rem 3.5rem;
		text-align: center;
	}
	.name {
		margin: 0 0 1rem;
		font-family: var(--font-serif);
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--ink);
	}
	nav {
		display: flex;
		justify-content: center;
		gap: 1.4rem;
		margin-bottom: 1rem;
	}
	nav a {
		color: var(--muted);
		font-size: 0.9rem;
		text-decoration: none;
	}
	nav a:hover {
		color: var(--ink);
	}
	.copy {
		margin: 0;
		color: var(--muted);
		font-size: 0.8rem;
	}
</style>
