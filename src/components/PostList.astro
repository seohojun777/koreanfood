---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import PostImage from './PostImage.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">아직 올라온 글이 없습니다. 곧 첫 상을 차려 올리겠습니다.</p>
	) : (
		<ul>
			{posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						{post.data.heroImage && (
							<div class="thumb">
								<PostImage
									src={post.data.heroImage}
									alt={post.data.heroImageAlt ?? post.data.title}
									width={720}
									height={360}
								/>
							</div>
						)}
						{post.data.category && <span class="category">{post.data.category}</span>}
						<h2 class="title">{post.data.title}</h2>
						<p class="desc">{post.data.description}</p>
						<p class="date">
							<FormattedDate date={post.data.pubDate} />
						</p>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	ul {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 3rem 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.thumb {
		overflow: hidden;
		margin-bottom: 1rem;
		border: 1px solid var(--ink);
	}
	.thumb :global(img) {
		transition: transform 0.4s ease;
	}
	a:hover .thumb :global(img) {
		transform: scale(1.03);
	}
	.category {
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		color: var(--muted);
	}
	.title {
		margin: 0.3rem 0 0.5rem;
		font-size: 1.25rem;
	}
	a:hover .title {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.desc {
		margin: 0 0 0.4rem;
		font-size: 0.93rem;
		color: var(--muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.date {
		margin: 0;
		font-size: 0.82rem;
		color: var(--muted);
	}
	.empty {
		padding: 4rem 0;
		text-align: center;
		color: var(--muted);
	}
	@media (max-width: 720px) {
		ul {
			grid-template-columns: 1fr;
		}
	}
</style>
